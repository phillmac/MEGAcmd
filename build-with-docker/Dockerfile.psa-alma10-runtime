# Rootless AlmaLinux 10.2 *runtime* for the pinned MEGAcmd 2.7 PSA patch.
# Build the full-feature Release recipe first; no MEGA credentials are baked in.
# Tested only as an isolated image; do not install over the live 2.5.2 daemon.
ARG RELEASE_IMAGE=localhost/megacmd-psa-full-release-linked:2.7
FROM ${RELEASE_IMAGE} AS release
FROM quay.io/almalinuxorg/almalinux:10.2
RUN dnf -y --setopt=install_weak_deps=False install fuse-libs && dnf clean all
COPY --from=release /opt/megacmd-psa-full-release /opt/megacmd-psa-full-release
ENV HOME=/home/almalinux
ENV LD_LIBRARY_PATH=/opt/megacmd-psa-full-release/lib
WORKDIR /home/almalinux
RUN mkdir -p /home/almalinux/.megaCmd && chmod 0700 /home/almalinux/.megaCmd \
    && echo '76ae6af668ee6735731d3a1af2c56fd080b08cca498bd3510b543c274ec2942c  /opt/megacmd-psa-full-release/mega-cmd-server' | sha256sum -c - \
    && for b in mega-cmd-server mega-cmd mega-exec; do \
         test -x "/opt/megacmd-psa-full-release/$b" || exit 3; \
         test -z "$(ldd "/opt/megacmd-psa-full-release/$b" | grep 'not found')" || exit 4; \
       done
STOPSIGNAL SIGTERM
ENTRYPOINT ["/opt/megacmd-psa-full-release/mega-cmd-server"]
CMD ["--do-not-log-to-stdout"]
